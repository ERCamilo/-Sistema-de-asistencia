#!/bin/sh
# Post-commit hook — sync CACHE_VERSION and BUILD in the working tree with what
# the pre-commit hook wrote into the index, so `git status` stays clean.
#
# Background: the pre-commit hook patches CACHE_VERSION only in the git index
# (via git hash-object + git update-index --cacheinfo) to avoid accidentally
# staging partial working-tree edits to sw.js.  Side-effect: after the commit
# the working tree still carries the old CACHE_VERSION, showing as "modified".
#
# Fix: we do NOT `git checkout HEAD -- ...` (that would wipe unrelated
# working-tree changes). Instead we read only the generated values from HEAD
# and apply them surgically with perl, touching nothing else.

SW_FILE="sw.js"
BUILD_FILE="js/modules/config/BuildInfo.js"

if [ ! -f "$SW_FILE" ]; then
    exit 0
fi

# Read the CACHE_VERSION that the pre-commit hook wrote into HEAD.
HEAD_VERSION=$(git show HEAD:"$SW_FILE" 2>/dev/null \
    | grep "const CACHE_VERSION = '" \
    | sed "s/.*CACHE_VERSION = '//;s/'.*//")

if [ -z "$HEAD_VERSION" ]; then
    exit 0
fi

# Check if the working tree already has the right version (nothing to do).
WT_VERSION=$(grep "const CACHE_VERSION = '" "$SW_FILE" \
    | sed "s/.*CACHE_VERSION = '//;s/'.*//")

if [ "$WT_VERSION" != "$HEAD_VERSION" ]; then
    perl -pi -e "s/const CACHE_VERSION = '[^']*'/const CACHE_VERSION = '$HEAD_VERSION'/" "$SW_FILE"
fi

if [ -f "$BUILD_FILE" ]; then
    HEAD_BUILD=$(git show HEAD:"$BUILD_FILE" 2>/dev/null \
        | grep "const BUILD = '" \
        | sed "s/.*BUILD = '//;s/'.*//")
    WT_BUILD=$(grep "const BUILD = '" "$BUILD_FILE" \
        | sed "s/.*BUILD = '//;s/'.*//")

    if [ -n "$HEAD_BUILD" ] && [ "$WT_BUILD" != "$HEAD_BUILD" ]; then
        perl -pi -e "s/const BUILD = '[^']*'/const BUILD = '$HEAD_BUILD'/" "$BUILD_FILE"
    fi
fi
