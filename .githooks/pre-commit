#!/bin/sh
# Pre-commit hook — auto-bump sw.js CACHE_VERSION on every commit that
# touches web assets (JS/CSS/HTML), so browsers always get fresh code.
#
# Version format: YYYY.MMDD.HHmm  (e.g. 2026.0606.1430)
#   - Monotonically increasing  → no merge conflicts on version ordering
#   - Human-readable            → tells you exactly when it was deployed
#   - No manual tracking        → you never forget to bump it
#
# Install once:  pnpm run install-hooks
# (also runs automatically on `pnpm install` via the "prepare" script)

SW_FILE="sw.js"

# ── 1. Skip if sw.js doesn't exist (monorepo / unusual setup) ────────────────
if [ ! -f "$SW_FILE" ]; then
    exit 0
fi

# ── 2. Only bump when files that actually run in the browser change ───────────
# Exclude pure-Jest wrappers (*.test.js), jest config, and babel config
# since those are never served to end users.
CHANGED_ASSETS=$(git diff --cached --name-only \
    | grep -E '\.(js|css|html)$' \
    | grep -Ev '(\.test\.js$|jest\.(config|setup)\.js$|babel\.config\.js$)')

if [ -z "$CHANGED_ASSETS" ]; then
    exit 0
fi

# ── 3. Generate new version (date + time, always increasing) ─────────────────
NEW_VERSION=$(date +"%Y.%m%d.%H%M")

# ── 4. Read current version for the log message ──────────────────────────────
OLD_VERSION=$(grep "const CACHE_VERSION = '" "$SW_FILE" \
    | sed "s/.*CACHE_VERSION = '//;s/'.*//")

# ── 5. Replace version in-place (perl: cross-platform, no -i '' issues) ──────
perl -pi -e "s/const CACHE_VERSION = '[^']*'/const CACHE_VERSION = '$NEW_VERSION'/" "$SW_FILE"

# ── 6. Stage the updated sw.js so it's included in this commit ───────────────
git add "$SW_FILE"

echo "  ↺  sw.js cache: ${OLD_VERSION:-<unknown>} → $NEW_VERSION"
