{
  "comment": "El SDK de Firebase se carga en runtime desde el CDN gstatic (10.8.0) en js/modules/data/firebase.js — esa es la única fuente de verdad. No se declara 'firebase' como dependencia npm porque ningún módulo ni test lo importa; los tests lo mockean vía moduleNameMapper.",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "axe-core": "4.14.0",
    "babel-jest": "^29.7.0",
    "esbuild": "^0.24.2",
    "fake-indexeddb": "^6.2.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "puppeteer-core": "^25.0.4"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint:state": "node scripts/check-state-writes.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "install-hooks": "git config core.hooksPath .githooks && echo '✓ Git hooks instalados (.githooks/)'",
    "sw:precache": "node scripts/sw-precache.cjs",
    "build": "node scripts/release-manifest.cjs && node scripts/build.cjs",
    "test:settings-layout": "node scripts/check-settings-layout.cjs",
    "test:mini-review-layout": "node scripts/check-mini-review-layout.cjs",
    "test:photo-viewer": "node scripts/check-photo-viewer.cjs",
    "test:loans-load-time": "node scripts/check-loans-load-time.cjs",
    "test:loan-history-layout": "node scripts/check-loan-history-layout.cjs",
    "test:app-updates": "node scripts/check-app-updates.cjs",
    "test:release": "node scripts/release-manifest.cjs --check --release"
  }
}
