<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Posición de préstamo · Propuesta SA #313</title>
<style>
:root{color-scheme:dark;--bg:oklch(.185 .012 245);--panel:oklch(.228 .013 245);--panel-2:oklch(.268 .014 245);--hover:oklch(.310 .015 245);--border:oklch(.330 .014 245);--text:oklch(.960 .004 245);--dim:oklch(.740 .010 245);--accent:oklch(.760 .110 205);--on:oklch(.160 .020 240);--good:oklch(.740 .120 158);--warn:oklch(.820 .110 78);--bad:oklch(.680 .160 25)}
*{box-sizing:border-box}body{margin:0;min-height:100vh;background:var(--bg);color:var(--text);font:14px 'IBM Plex Sans',system-ui,sans-serif;display:grid;place-items:center;padding:14px}button,input,select{font:inherit}button{cursor:pointer;min-height:44px;border:0;border-radius:10px;padding:10px 15px;background:var(--panel-2);color:var(--text);font-weight:650}button:hover:not(:disabled){background:var(--hover)}button:disabled{opacity:.45;cursor:default}button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--accent);outline-offset:3px}button.primary{background:var(--accent);color:var(--on)}svg{width:22px;height:22px;vertical-align:middle;flex-shrink:0}dialog{padding:0;margin:auto;border:1px solid var(--border);border-radius:22px;background:var(--panel);color:var(--text);width:min(620px,calc(100vw - 28px));max-height:calc(100dvh - 28px);box-shadow:0 24px 80px #0009;overflow:hidden}dialog[open]{display:flex;flex-direction:column}header,.nav,footer,.prototype-note{flex-shrink:0}#body{flex:1}dialog::backdrop{background:#060b14bd}header{padding:20px 22px 12px;display:flex;align-items:center;gap:12px}header .grow{flex:1;min-width:0}h1{font-size:25px;line-height:1.2;letter-spacing:-.02em;margin:0 0 5px}header small{color:var(--dim);font-size:11px}header>button{padding:9px;width:42px}.nav{display:flex;gap:6px;padding:0 22px 15px;border-bottom:1px solid var(--border)}.nav button{flex:1;min-width:0;font-size:12px;padding:8px 4px;color:var(--dim)}.nav button[aria-current=page]{background:var(--accent);color:var(--on)}#body{padding:22px;overflow:auto;min-height:0;max-height:calc(100dvh - 245px)}footer{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;padding:15px 22px;border-top:1px solid var(--border)}footer p{font-size:11px;line-height:1.4;margin:0;color:var(--dim);text-align:center}footer button{white-space:nowrap}.card{border:1px solid var(--border);border-radius:16px;background:var(--panel-2);padding:16px;margin-bottom:16px}.person{display:flex;align-items:center;gap:13px}.avatar{width:50px;height:50px;background:var(--warn);border-radius:50%;display:grid;place-items:center;color:var(--on)}.person strong{font-size:20px}.person p{margin:3px 0;color:var(--dim);font-size:12px}.eyebrow{display:block;color:var(--dim);font-size:11px;font-weight:650;margin-bottom:8px}h2{font-size:17px;margin:0 0 8px}p{line-height:1.55}.muted{color:var(--dim);font-size:12px;margin:8px 0 0}.chip{display:inline-block;background:var(--accent);color:var(--on);font-size:10px;line-height:1.2;font-weight:750;border-radius:6px;padding:5px 7px}.chip.warn{background:var(--warn)}.chip.good{background:var(--good)}.chip.bad{background:var(--bad)}.row{display:flex;align-items:center;justify-content:space-between;gap:12px}.row+.row{margin-top:12px}.num{font-family:'IBM Plex Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums}.big{font-size:36px;font-weight:700;letter-spacing:-.04em;margin:0}.sub{font-size:12px;color:var(--dim)}.grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}label{display:block;color:var(--dim);font-size:12px;font-weight:600}input,select{display:block;width:100%;min-width:0;margin-top:7px;border:1px solid var(--border);border-radius:10px;padding:12px 10px;min-height:45px;background:var(--bg);color:var(--text)}input[type=range]{padding:0;background:none;accent-color:var(--accent);margin:14px 0}input[type=date]{font-size:13px}select{font-size:13px}.stack{display:grid;gap:13px}.notice{border-radius:12px;padding:11px 13px;font-size:12px;background:var(--panel-2);color:var(--dim);line-height:1.5}.notice strong{color:var(--text)}.summary{border-left:3px solid var(--accent)}.segments{display:flex;gap:7px;margin-bottom:17px}.segments button{flex:1;padding:9px 5px;line-height:1.3;font-size:12px}.segments button[aria-pressed=true]{background:var(--accent);color:var(--on)}.hours{font-size:25px;font-weight:700}.bar{height:9px;border-radius:10px;overflow:hidden;background:var(--warn);margin:15px 0}.bar span{display:block;height:100%;background:var(--accent)}.leader{margin:0}.leader h2{margin-bottom:13px}.leader .row{align-items:flex-start;font-size:12px}.leader .num{font-size:15px;font-weight:650;white-space:nowrap}.line{height:1px;background:var(--border);margin:14px 0}.pay{padding:15px 0 2px}.pay strong{font-size:20px}.callout{margin-top:16px;text-align:center}.footer-back{background:transparent;color:var(--dim)}.empty{padding:16px 0 4px}.empty svg{width:30px;height:30px;color:var(--accent)}.title-icon{background:var(--accent);color:var(--on);width:42px;height:42px;border-radius:12px;display:grid;place-items:center;flex-shrink:0}.prototype-note{font-size:10px;color:var(--dim);text-align:center;padding:0 0 12px;margin:0}.error{color:#ffc9c9}.mono-value{color:var(--text);font-weight:650}.sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
@media(max-width:480px){body{padding:8px}dialog{width:calc(100vw - 16px);max-height:calc(100dvh - 16px);border-radius:20px}header{padding:17px 16px 10px}h1{font-size:23px}.nav{padding:0 16px 12px}#body{padding:16px;max-height:calc(100dvh - 230px)}footer{padding:12px 16px;gap:6px}footer button{font-size:12px;padding:10px}.grid.leaders{grid-template-columns:1fr}footer p{font-size:10px}.big{font-size:32px}.card{padding:14px}.person strong{font-size:18px}.segments button{font-size:11px}.grid{gap:10px}.prototype-note{padding-bottom:10px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}

.switch{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:13px;color:var(--text)}
.switch input{padding:0;width:24px;height:24px;min-height:24px;margin:0;accent-color:var(--accent)}
.payer-label{margin-top:16px}.position-name{display:flex;align-items:center;gap:8px;font-weight:650}.position-name svg{color:var(--accent)}.position-rate{font-size:22px;margin:10px 0 0;font-weight:700}.mode-link{display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;margin-top:14px;text-align:left;padding:12px;background:var(--bg)}.mode-link small{display:block;color:var(--dim);font-size:10px;font-weight:500;margin-bottom:5px}.mode-link strong{font-size:12px}
.modes{display:grid;gap:12px;margin:16px 0}.modes button{text-align:left;padding:17px;border:1px solid var(--border)}.modes button[aria-pressed=true]{background:var(--accent);color:var(--on);border-color:var(--accent)}.modes button strong{display:block;font-size:15px}.modes button small{display:block;margin-top:7px;font-size:12px;font-weight:500}.segments{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}.pay-split{font-size:12px;flex-wrap:wrap;margin-top:15px;padding-top:12px;border-top:1px solid var(--border)}.pay-split strong{margin-left:5px}#loan-fields[hidden]{display:none}
@media(max-width:480px){.segments{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
</head>
<body>
<main><button id="reopen" type="button">Abrir maqueta de cesión</button></main>
<dialog id="shell" aria-labelledby="title"><header><span class="title-icon" id="head-icon"></span><div class="grow"><h1 id="title" tabindex="-1">Cesión temporal</h1><small>Propuesta #313 · Juan Pérez #113</small></div><button id="close" type="button" aria-label="Cerrar maqueta"></button></header><nav class="nav" aria-label="Vistas de la propuesta"><button data-view="profile">Empleado</button><button data-view="attendance" disabled>Asistencia</button><button data-view="report" disabled>Reporte</button></nav><div id="body" tabindex="0" role="region" aria-label="Contenido de la propuesta"></div><footer><button class="footer-back" id="back" type="button">Volver</button><p id="hint"></p><button class="primary" id="next" type="button" aria-describedby="hint">Configurar</button></footer><p class="prototype-note">Maqueta interactiva · datos ficticios · cambios solo en esta pantalla</p></dialog>
<script>
const icons={people:'<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M16 3a4 4 0 0 1 0 8M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/>',close:'<path d="m6 6 12 12M18 6 6 18"/>',bricks:'<path d="M3 4h18v16H3zM3 9h18M3 15h18M9 4v5M15 9v6M9 15v5"/>',bolt:'<path d="m13 2-3 8H4l7 12 3-8h6L13 2Z"/>',swap:'<path d="M4 7h15m-4-4 4 4-4 4M20 17H5m4-4-4 4 4 4"/>'};
const icon=name=>'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'+icons[name]+'</svg>';
const money=n=>'$'+n.toLocaleString('es-DO',{minimumFractionDigits:2,maximumFractionDigits:2});
const number=n=>n.toLocaleString('es-DO',{maximumFractionDigits:2});
const signedMoney=n=>(n>0?'+':n<0?'−':'')+money(Math.abs(n));
const modeLabels={split:'Repartido en nómina',all:'Pagador cubre todo',outside:'Diferencia fuera de nómina'};
const state={view:'profile',isLoan:false,payer:'Luis',receiver:'Marcos',mode:'split',draftMode:'split',variant:'full',hours:8,ceded:8,factor:1};
const shell=document.getElementById('shell'),body=document.getElementById('body'),title=document.getElementById('title'),hint=document.getElementById('hint'),next=document.getElementById('next'),back=document.getElementById('back');
document.getElementById('head-icon').innerHTML=icon('swap');document.getElementById('close').innerHTML=icon('close');
const metric=(label,id)=>'<div><span class="eyebrow">'+label+'</span><strong class="hours num" id="'+id+'"></strong></div>';
function updateNav(){for(const btn of document.querySelectorAll('[data-view]')){btn.disabled=btn.dataset.view!=='profile'&&!state.isLoan;btn.toggleAttribute('aria-current',btn.dataset.view===(state.view==='edit'?'profile':state.view));if(btn.hasAttribute('aria-current'))btn.setAttribute('aria-current','page');}next.disabled=state.view==='profile'&&!state.isLoan;}
function profile(){return '<div class="person"><span class="avatar">'+icon('people')+'</span><div><strong>Juan Pérez</strong><p>#113 · dos posiciones asignadas</p></div></div><div class="line"></div><div class="card"><div class="row"><strong>Albañil · Luis</strong><span class="chip warn">PRINCIPAL</span></div><p class="num position-rate">$900 / día</p><p class="muted">Referencia de la primera posición</p></div><div class="card summary secondary"><div class="row"><span class="position-name">'+icon('bolt')+' Electricista</span><strong class="num">$1,200 / día</strong></div><p class="muted">Líder del equipo: Marcos</p><div class="line"></div><label class="switch">Es posición de préstamo<input type="checkbox" id="loan" '+(state.isLoan?'checked':'')+'></label><div id="loan-fields" '+(state.isLoan?'':'hidden')+'><label class="payer-label">Quién paga<select id="payer"><option>Luis</option><option>Marcos</option><option>Ana</option></select></label><p class="muted" id="payer-source"></p><button type="button" class="mode-link" id="edit"><span><small>Forma de pago</small><strong>'+modeLabels[state.mode]+'</strong></span><span aria-hidden="true">→</span></button><p class="muted">Receptor: Marcos, por el puesto seleccionado.</p></div></div>';}
function edit(){return '<div class="notice summary">Primera posición <strong>$900</strong> · segunda <strong>$1,200</strong><br>Ejemplo de una jornada completa, sin descuentos.</div><div class="modes" role="group" aria-label="Modalidad de pago"><button type="button" data-mode="split"><strong>Repartido en nómina</strong><small>'+state.payer+' $900 · Marcos $300</small></button><button type="button" data-mode="all"><strong>Pagador cubre todo</strong><small>'+state.payer+' $1,200 · '+(state.payer===state.receiver?'sin compensación entre líderes':'Marcos compensa $1,200')+'</small></button><button type="button" data-mode="outside"><strong>Diferencia fuera de nómina</strong><small>'+state.payer+' $900 · $300 fuera de nómina</small></button></div><p class="notice">Propuesta para revisar. Seleccionar una modalidad no confirma pagos.</p>';}
function attendance(){return '<div class="segments" role="group" aria-label="Ejemplos de asistencia"><button data-case="full">Día completo</button><button data-case="half">Media jornada</button><button data-case="mixed">Día mixto</button><button data-case="holiday">Feriado ×2</button></div><div class="card"><div class="row"><h2 id="hours-title"></h2><span class="chip" id="day-label"></span></div><label for="hours">Horas en posición prestada<input id="hours" type="range" min="0" step="0.5"></label><div class="grid">'+metric('Primera · Luis','home-hours')+metric('Segunda · Marcos','away-hours')+'</div><div class="bar" aria-hidden="true"><span id="bar"></span></div><p class="muted">'+modeLabels[state.mode]+' · pagador elegido: '+state.payer+'</p></div><div class="card summary"><span class="eyebrow">Salario del trabajo de Juan</span><strong class="big num" id="wage"></strong><div class="row pay-split"><span>Nómina <strong class="num" id="in-payroll"></strong></span><span>Fuera <strong class="num" id="outside"></strong></span></div></div><p class="notice" id="attendance-note"></p>';}
function report(){return '<div class="card summary"><span class="eyebrow">Salario del trabajo de Juan</span><strong class="big num" id="wage"></strong><p class="muted" id="global"></p><div class="row pay-split"><span>Nómina <strong class="num" id="in-payroll"></strong></span><span>Fuera <strong class="num" id="outside"></strong></span></div></div><div class="grid leaders" id="leader-cards"></div><p class="notice callout" id="transfer"></p><p class="muted">El saldo entre líderes no se vuelve a sumar al sueldo. La parte externa no se marca como pagada.</p>';}
function text(id,value){const el=document.getElementById(id);if(el)el.textContent=value;}
function compute(){const home=state.hours-state.ceded,homePay=home*900/8*state.factor,cededPay=state.ceded*1200/8*state.factor,reference=state.ceded*900/8*state.factor,difference=cededPay-reference,payrollFromPayer=state.mode==='all'?cededPay:reference,outside=state.mode==='outside'?difference:0,fromReceiver=state.mode==='split'?difference:0,comp=state.payer===state.receiver?0:payrollFromPayer,leaders=new Map();const add=(name,key,value)=>{if(!leaders.has(name))leaders.set(name,{name,received:0,payroll:0,balance:0,outside:0});leaders.get(name)[key]+=value;};add(state.payer,'payroll',payrollFromPayer);add(state.receiver,'payroll',fromReceiver);add(state.receiver,'received',state.ceded);add(state.receiver,'outside',outside);if(home>0){add('Luis','received',home);add('Luis','payroll',homePay);}if(comp){add(state.payer,'balance',comp);add(state.receiver,'balance',-comp);}return {home,homePay,cededPay,reference,difference,outside,comp,gross:homePay+cededPay,payroll:homePay+payrollFromPayer+fromReceiver,leaders:[...leaders.values()]};}
function update(){const c=compute();document.querySelectorAll('[data-case]').forEach(btn=>btn.setAttribute('aria-pressed',String(btn.dataset.case===state.variant)));text('home-hours',number(c.home)+' h');text('away-hours',number(state.ceded)+' h');text('hours-title','Repartir '+number(state.hours)+' horas');text('day-label',state.factor===2?'EJEMPLO ×2':'DÍA NORMAL');text('wage',money(c.gross));text('in-payroll',money(c.payroll));text('outside',money(c.outside));const bar=document.getElementById('bar');if(bar)bar.style.width=(c.home/state.hours*100)+'%';text('attendance-note',state.variant==='mixed'?'4 h a $900/día + 4 h a $1,200/día = $1,050. La parte de préstamo se calcula por separado.':'Proporción y recargos propuestos para revisar: no cambian la configuración de SA.');text('global',number(state.hours/8)+(state.hours===8?' jornada base · ':' jornadas base · ')+number(state.hours/8*state.factor)+(state.hours/8*state.factor===1?' equivalente · ':' equivalentes · ')+number(state.hours)+' h base');const cards=document.getElementById('leader-cards');if(cards)cards.innerHTML=c.leaders.map(l=>'<section class="card leader"><div class="row"><h2>'+l.name+'</h2><span class="chip '+(l.name===state.payer?'good':'warn')+'">'+(l.name===state.payer?'PAGADOR':'EQUIPO')+'</span></div><div class="row"><span>Trabajo recibido</span><strong class="num">'+number(l.received/8)+' jornadas</strong></div><div class="line"></div><div class="row"><span>Saldo por préstamo</span><strong class="num">'+signedMoney(l.balance)+'</strong></div><div class="row pay"><span>Nómina de Juan</span><strong class="num">'+money(l.payroll)+'</strong></div>'+(l.outside?'<p class="muted">Fuera de nómina: '+money(l.outside)+' · sin confirmar pago</p>':'')+'</section>').join('');text('transfer',c.comp?'Marcos → '+state.payer+': '+money(c.comp)+' por compensar. El bruto de Juan sigue siendo '+money(c.gross)+'.':'Sin compensación entre líderes: las partes del mismo pagador se agrupan.');}
function updateModes(){document.querySelectorAll('[data-mode]').forEach(btn=>btn.setAttribute('aria-pressed',String(btn.dataset.mode===state.draftMode)));}
function updateProfile(){const fields=document.getElementById('loan-fields');if(fields)fields.hidden=!state.isLoan;text('payer-source',state.payer==='Luis'?'Sugerido desde la posición principal.':state.payer==='Marcos'?'Pagador y receptor coinciden: sin compensación consigo mismo.':'Solo cambia quién paga el trabajo de la posición prestada.');hint.textContent=state.isLoan?'Receptor: Marcos · condiciones por revisar.':'Activa préstamo para revisar el reparto.';updateNav();}
function render(view){const before=shell.getBoundingClientRect();state.view=view;title.textContent={profile:'Posiciones de Juan',edit:'Cómo se paga',attendance:'Asignar el día',report:'Sueldo y compensación'}[view];body.innerHTML=({profile,edit,attendance,report}[view])();back.disabled=view==='profile';next.textContent=view==='edit'?'Aplicar a maqueta':view==='report'?'Volver al empleado':view==='attendance'?'Ver reporte':'Ver asistencia';hint.textContent=view==='edit'?'Modalidades según tu ejemplo de $900 / $1,200.':view==='attendance'?'Horas y recargos: proporción por confirmar.':view==='report'?'La compensación global suma cero.':'';if(view==='profile'){document.getElementById('payer').value=state.payer;updateProfile();}else if(view==='edit')updateModes();else{if(view==='attendance'){document.getElementById('hours').max=state.hours;document.getElementById('hours').value=state.ceded;}update();}updateNav();body.scrollTop=0;if(shell.open){const after=shell.getBoundingClientRect();if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&before.height&&before.height!==after.height)shell.animate([{height:before.height+'px'},{height:after.height+'px'}],{duration:260,easing:'cubic-bezier(.2,.8,.2,1)'});title.focus({preventScroll:true});}}
body.addEventListener('change',event=>{if(event.target.id==='loan'){state.isLoan=event.target.checked;updateProfile();}if(event.target.id==='payer'){state.payer=event.target.value;updateProfile();}});body.addEventListener('input',event=>{if(event.target.id==='hours'){state.ceded=Number(event.target.value);state.variant='custom';update();}});body.addEventListener('click',event=>{const preset=event.target.closest('[data-case]');if(preset){state.variant=preset.dataset.case;state.hours=state.variant==='half'?4:8;state.ceded=state.variant==='mixed'?4:state.hours;state.factor=state.variant==='holiday'?2:1;document.getElementById('hours').max=state.hours;document.getElementById('hours').value=state.ceded;update();}const mode=event.target.closest('[data-mode]');if(mode){state.draftMode=mode.dataset.mode;updateModes();}if(event.target.closest('#edit')){state.draftMode=state.mode;render('edit');}});
next.onclick=()=>{if(state.view==='profile'&&state.isLoan)render('attendance');else if(state.view==='edit'){state.mode=state.draftMode;render('profile');}else if(state.view==='attendance')render('report');else if(state.view==='report')render('profile');};back.onclick=()=>render(state.view==='report'?'attendance':'profile');for(const btn of document.querySelectorAll('[data-view]'))btn.onclick=()=>{if(btn.dataset.view==='profile'||state.isLoan)render(btn.dataset.view);};document.getElementById('close').onclick=()=>shell.close();document.getElementById('reopen').onclick=()=>{shell.showModal();title.focus();};shell.addEventListener('cancel',event=>{if(state.view==='edit'){event.preventDefault();render('profile');}});shell.addEventListener('close',()=>document.getElementById('reopen').focus());render('profile');shell.showModal();title.focus();

</script></body></html>
