<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Posición de préstamo · Propuesta SA #313</title>
<style>
:root{color-scheme:dark;--bg:oklch(.185 .012 245);--panel:oklch(.228 .013 245);--panel-2:oklch(.268 .014 245);--hover:oklch(.310 .015 245);--border:oklch(.330 .014 245);--text:oklch(.960 .004 245);--dim:oklch(.740 .010 245);--accent:oklch(.760 .110 205);--on:oklch(.160 .020 240);--good:oklch(.740 .120 158);--warn:oklch(.820 .110 78);--bad:oklch(.680 .160 25)}
*{box-sizing:border-box}body{margin:0;min-height:100vh;background:var(--bg);color:var(--text);font:14px 'IBM Plex Sans',system-ui,sans-serif;display:grid;place-items:center;padding:14px}button,input,select{font:inherit}button{cursor:pointer;min-height:44px;border:0;border-radius:10px;padding:10px 15px;background:var(--panel-2);color:var(--text);font-weight:650}button:hover:not(:disabled){background:var(--hover)}button:disabled{opacity:.45;cursor:default}button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--accent);outline-offset:3px}button.primary{background:var(--accent);color:var(--on)}svg{width:22px;height:22px;vertical-align:middle;flex-shrink:0}dialog{padding:0;margin:auto;border:1px solid var(--border);border-radius:22px;background:var(--panel);color:var(--text);width:min(620px,calc(100vw - 28px));max-height:calc(100dvh - 28px);box-shadow:0 24px 80px #0009;overflow:hidden}dialog[open]{display:flex;flex-direction:column}header,.nav,footer,.prototype-note{flex-shrink:0}#body{flex:1}dialog::backdrop{background:#060b14bd}header{padding:20px 22px 12px;display:flex;align-items:center;gap:12px}header .grow{flex:1;min-width:0}h1{font-size:25px;line-height:1.2;letter-spacing:-.02em;margin:0 0 5px}header small{color:var(--dim);font-size:11px}header>button{padding:9px;width:42px}.nav{display:flex;gap:6px;padding:0 22px 15px;border-bottom:1px solid var(--border)}.nav button{flex:1;min-width:0;font-size:12px;padding:8px 4px;color:var(--dim)}.nav button[aria-current=page]{background:var(--accent);color:var(--on)}#body{padding:22px;overflow:auto;min-height:0;max-height:calc(100dvh - 245px)}footer{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;padding:15px 22px;border-top:1px solid var(--border)}footer p{font-size:11px;line-height:1.4;margin:0;color:var(--dim);text-align:center}footer button{white-space:nowrap}.card{border:1px solid var(--border);border-radius:16px;background:var(--panel-2);padding:16px;margin-bottom:16px}.person{display:flex;align-items:center;gap:13px}.avatar{width:50px;height:50px;background:var(--warn);border-radius:50%;display:grid;place-items:center;color:var(--on)}.person strong{font-size:20px}.person p{margin:3px 0;color:var(--dim);font-size:12px}.eyebrow{display:block;color:var(--dim);font-size:11px;font-weight:650;margin-bottom:8px}h2{font-size:17px;margin:0 0 8px}p{line-height:1.55}.muted{color:var(--dim);font-size:12px;margin:8px 0 0}.chip{display:inline-block;background:var(--accent);color:var(--on);font-size:10px;line-height:1.2;font-weight:750;border-radius:6px;padding:5px 7px}.chip.warn{background:var(--warn)}.chip.good{background:var(--good)}.chip.bad{background:var(--bad)}.row{display:flex;align-items:center;justify-content:space-between;gap:12px}.row+.row{margin-top:12px}.num{font-family:'IBM Plex Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums}.big{font-size:36px;font-weight:700;letter-spacing:-.04em;margin:0}.sub{font-size:12px;color:var(--dim)}.grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}label{display:block;color:var(--dim);font-size:12px;font-weight:600}input,select{display:block;width:100%;min-width:0;margin-top:7px;border:1px solid var(--border);border-radius:10px;padding:12px 10px;min-height:45px;background:var(--bg);color:var(--text)}input[type=range]{padding:0;background:none;accent-color:var(--accent);margin:14px 0}input[type=date]{font-size:13px}select{font-size:13px}.stack{display:grid;gap:13px}.notice{border-radius:12px;padding:11px 13px;font-size:12px;background:var(--panel-2);color:var(--dim);line-height:1.5}.notice strong{color:var(--text)}.summary{border-left:3px solid var(--accent)}.segments{display:flex;gap:7px;margin-bottom:17px}.segments button{flex:1;padding:9px 5px;line-height:1.3;font-size:12px}.segments button[aria-pressed=true]{background:var(--accent);color:var(--on)}.hours{font-size:25px;font-weight:700}.bar{height:9px;border-radius:10px;overflow:hidden;background:var(--warn);margin:15px 0}.bar span{display:block;height:100%;background:var(--accent)}.leader{margin:0}.leader h2{margin-bottom:13px}.leader .row{align-items:flex-start;font-size:12px}.leader .num{font-size:15px;font-weight:650;white-space:nowrap}.line{height:1px;background:var(--border);margin:14px 0}.pay{padding:15px 0 2px}.pay strong{font-size:20px}.callout{margin-top:16px;text-align:center}.footer-back{background:transparent;color:var(--dim)}.empty{padding:16px 0 4px}.empty svg{width:30px;height:30px;color:var(--accent)}.title-icon{background:var(--accent);color:var(--on);width:42px;height:42px;border-radius:12px;display:grid;place-items:center;flex-shrink:0}.prototype-note{font-size:10px;color:var(--dim);text-align:center;padding:0 0 12px;margin:0}.error{color:#ffc9c9}.mono-value{color:var(--text);font-weight:650}.sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
@media(max-width:480px){body{padding:8px}dialog{width:calc(100vw - 16px);max-height:calc(100dvh - 16px);border-radius:20px}header{padding:17px 16px 10px}h1{font-size:23px}.nav{padding:0 16px 12px}#body{padding:16px;max-height:calc(100dvh - 230px)}footer{padding:12px 16px;gap:6px}footer button{font-size:12px;padding:10px}.grid.leaders{grid-template-columns:1fr}footer p{font-size:10px}.big{font-size:32px}.card{padding:14px}.person strong{font-size:18px}.segments button{font-size:11px}.grid{gap:10px}.prototype-note{padding-bottom:10px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}

.switch{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:13px;color:var(--text)}
.switch input{padding:0;width:24px;height:24px;min-height:24px;margin:0;accent-color:var(--accent)}
.position-fields{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px;margin-top:16px;align-items:end}.position-fields .eyebrow{margin-bottom:0}.position-fields .position-rate{margin:7px 0 0}.position-fields>label{display:flex;flex-direction:column;justify-content:flex-end}.position-name{display:flex;align-items:center;gap:8px;font-weight:650}.position-name svg{color:var(--accent)}.position-rate{font-size:22px;margin:10px 0 0;font-weight:700}
.segments{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}#loan-fields[hidden]{display:none}
@media(max-width:480px){.segments{grid-template-columns:repeat(2,minmax(0,1fr))}}

.fields-leaders{margin-top:16px}.special-adjustment{margin-top:16px;border-left:3px solid var(--warn)}.group-title{align-items:flex-start;margin-top:15px}.group-title>strong:first-child{font-size:13px;line-height:1.5}.group-title .num{font-size:18px;white-space:nowrap}.detail-toggle{display:flex;align-items:center;justify-content:space-between;width:100%;background:transparent;padding:10px 0;color:var(--dim);font-size:11px;font-weight:500}.detail-toggle[aria-expanded=true] svg{transform:rotate(180deg)}.adjustment-person{padding:13px 0;border-top:1px solid var(--border);font-size:12px}.detail-expression{font-size:11px;line-height:1.6;margin-bottom:0}.muted-adjustment .group-title{opacity:.6}.example-two{margin:0 0 16px;font-size:12px}.leader-balance{margin-top:16px}#adjustment-detail[hidden]{display:none}

.group-line{display:grid;grid-template-columns:24px minmax(0,1fr) auto;align-items:center;gap:10px}.group-line>input{width:22px;height:22px;min-height:22px;padding:0;margin:0;accent-color:var(--accent)}.group-line .detail-toggle{display:block;padding:4px 0;text-align:left;color:var(--text);font-size:12px;line-height:1.45;background:transparent}.detail-toggle small{display:block;margin-top:5px;color:var(--dim);font-weight:500;font-size:10px}.detail-toggle small svg{width:14px;height:14px}.group-line>strong{font-size:17px;white-space:nowrap}.muted-adjustment #group-amount{opacity:.6}.example-two{color:var(--dim);font-weight:500}

.loan-switch-row{display:flex;align-items:center;gap:4px;margin-top:15px;padding-top:10px;border-top:1px solid var(--border)}.loan-switch-row>label{flex:1;display:flex;align-items:center;min-height:44px;color:var(--text);font-size:13px}.help-button{width:44px;min-height:44px;display:grid;place-items:center;padding:0;background:transparent;color:var(--dim)}.help-button>span{display:grid;place-items:center;width:23px;height:23px;border:1px solid var(--dim);border-radius:50%;font-size:13px}#loan-switch{appearance:none;-webkit-appearance:none;width:44px;height:44px;min-height:44px;padding:0;margin:0;border:0;background:transparent;cursor:pointer;position:relative;flex-shrink:0}#loan-switch::before{content:'';position:absolute;inset:10px 0;border-radius:20px;background:var(--border)}#loan-switch::after{content:'';position:absolute;top:13px;left:3px;width:18px;height:18px;border-radius:50%;background:var(--text);transition:transform .18s ease}#loan-switch:checked::before{background:var(--accent)}#loan-switch:checked::after{transform:translateX(20px);background:var(--on)}#loan-badge[hidden],#loan-settings[hidden]{display:none}.is-loan{border-left-color:var(--warn)}.role-definitions{display:grid;gap:8px}.role-definitions p{font-size:11px;color:var(--dim);margin:0}.role-definitions strong{color:var(--text)}.payment-flow{display:grid;gap:10px;margin-top:12px}.flow-lane{display:grid;grid-template-columns:minmax(0,1fr) 12px minmax(0,1fr) 12px minmax(0,1fr);gap:3px;align-items:center}.flow-node{min-width:0;padding:8px 4px;background:var(--panel-2);border-radius:8px;text-align:center}.flow-node small{display:block;font-size:8px;color:var(--dim);margin-bottom:4px}.flow-node strong{display:block;font-size:11px;overflow-wrap:anywhere}.flow-arrow{color:var(--accent);text-align:center}.flow-adjustment .flow-arrow{color:var(--warn)}@media(prefers-reduced-motion:reduce){#loan-switch::after{transition:none}}

/* Morph through real layout, never by stretching the card or its text. */
#body{overflow-anchor:none;scrollbar-gutter:stable;overscroll-behavior:contain}
#assigned-position{transition:border-color 220ms ease,box-shadow 280ms ease}
#assigned-position.is-loan{box-shadow:0 0 0 1px oklch(.82 .11 78 / .08)}
.profile-reveal{display:grid;grid-template-rows:0fr;visibility:hidden;overflow-anchor:none;transition:grid-template-rows 280ms cubic-bezier(.2,.8,.2,1),visibility 0s linear 280ms}
.profile-reveal[data-open=true]{grid-template-rows:1fr;visibility:visible;transition:grid-template-rows 300ms cubic-bezier(.2,.8,.2,1),visibility 0s}
.profile-reveal-inner{display:flow-root;min-height:0;overflow:hidden}
.loan-help-panel{margin-top:14px;padding:12px;border-radius:12px;background:var(--bg)}
#loan-badge{opacity:0;visibility:hidden;transform:translateY(-2px) scale(.88);transform-origin:right center;transition:opacity 100ms ease,transform 160ms ease,visibility 0s linear 160ms}
.is-loan #loan-badge{opacity:1;visibility:visible;transform:translateY(0) scale(1);transition:opacity 170ms ease 35ms,transform 210ms cubic-bezier(.2,.8,.2,1) 35ms,visibility 0s}
.profile-reveal .fields-leaders>label,.profile-reveal #payer-note{opacity:0;transform:translateY(6px);transition:opacity 90ms ease,transform 130ms ease}
.profile-reveal[data-open=true] .fields-leaders>label,.profile-reveal[data-open=true] #payer-note{opacity:1;transform:translateY(0);transition:opacity 160ms ease var(--reveal-delay,65ms),transform 190ms cubic-bezier(.2,.8,.2,1) var(--reveal-delay,65ms)}
.fields-leaders>label:first-child{--reveal-delay:65ms}.fields-leaders>label:nth-child(2){--reveal-delay:95ms}#payer-note{--reveal-delay:125ms}
@media(prefers-reduced-motion:reduce){.profile-reveal,#assigned-position,#loan-badge,.profile-reveal *{transition:none!important}}
.flow-lane{min-height:52px}.flow-same{min-height:52px;margin:0;display:flex;align-items:center}

.role-help-dialog{width:min(430px,calc(100vw - 32px));max-height:calc(100dvh - 32px);border-color:var(--border);box-shadow:0 24px 80px #000a}
.role-help-dialog::backdrop{background:#0308109c;animation:role-backdrop-in 180ms ease both}
.role-help-dialog.is-closing::backdrop{animation:role-backdrop-out 140ms ease both}
.role-help-dialog header{padding:18px 18px 14px;gap:10px;border-bottom:1px solid var(--border)}
.role-help-dialog h2{font-size:21px;letter-spacing:-.015em;line-height:1.2;margin:0 0 5px}
.role-help-dialog header .muted{font-size:11px;margin:0}
.role-help-dialog .loan-help-panel{flex:1;min-height:0;margin:0;padding:18px;overflow:auto;background:transparent;border-radius:0;overscroll-behavior:contain;scrollbar-gutter:stable}
.role-help-dialog footer{display:flex;justify-content:flex-end;padding:13px 18px}
.role-help-dialog .role-definitions{gap:12px}.role-help-dialog .role-definitions p{font-size:12px;line-height:1.6}
.role-help-dialog .payment-flow{margin-top:16px;gap:12px}.role-help-dialog .flow-node{padding:10px 4px}.role-help-dialog .flow-node small{font-size:8px}.role-help-dialog .flow-node strong{font-size:12px}
.role-help-dialog[open] .role-definitions>p,.role-help-dialog[open] .flow-lane,.role-help-dialog[open] .loan-help-panel>.muted,.role-help-dialog[open] .loan-help-panel>.notice{animation:role-help-item 160ms cubic-bezier(.2,.8,.2,1) var(--help-delay,30ms) both}
.role-help-dialog .role-definitions>p:nth-child(2){--help-delay:55ms}.role-help-dialog .flow-lane:first-child{--help-delay:80ms}.role-help-dialog .flow-lane:nth-child(2){--help-delay:110ms}.role-help-dialog .loan-help-panel>.muted{--help-delay:130ms}
@keyframes role-help-item{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}
@keyframes role-backdrop-in{from{background:#03081000}to{background:#0308109c}}
@keyframes role-backdrop-out{from{background:#0308109c}to{background:#03081000}}
@media(prefers-reduced-motion:reduce){.role-help-dialog::backdrop,.role-help-dialog *{animation:none!important}}
</style>
</head>
<body>
<main><button id="reopen" type="button">Abrir maqueta de cesión</button></main>
<dialog id="shell" aria-labelledby="title"><header><span class="title-icon" id="head-icon"></span><div class="grow"><h1 id="title" tabindex="-1">Cesión temporal</h1><small>Propuesta #313 · Juan Pérez #113</small></div><button id="close" type="button" aria-label="Cerrar maqueta"></button></header><nav class="nav" aria-label="Vistas de la propuesta"><button data-view="profile">Empleado</button><button data-view="attendance" disabled>Asistencia</button><button data-view="report" disabled>Reporte</button></nav><div id="body" tabindex="0" role="region" aria-label="Contenido de la propuesta"></div><footer><button class="footer-back" id="back" type="button">Volver</button><p id="hint"></p><button class="primary" id="next" type="button" aria-describedby="hint">Configurar</button></footer><p class="prototype-note">Maqueta interactiva · datos ficticios · cambios solo en esta pantalla</p></dialog>

<dialog id="role-help-dialog" class="role-help-dialog" aria-labelledby="role-help-title" aria-describedby="role-help-description"><header><div class="grow"><h2 id="role-help-title" tabindex="-1" autofocus>Equipo y pagador</h2><p id="role-help-description" class="muted">Juan cobra una sola vez.</p></div><button id="role-help-close" type="button" aria-label="Cerrar ayuda"></button></header><div id="role-help-body" class="loan-help-panel" tabindex="0" role="region" aria-label="Explicación de los líderes y recorrido del pago"></div><footer><button class="primary" id="role-help-done" type="button">Entendido</button></footer></dialog>
<script>
const icons={people:'<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M16 3a4 4 0 0 1 0 8M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/>',close:'<path d="m6 6 12 12M18 6 6 18"/>',bricks:'<path d="M3 4h18v16H3zM3 9h18M3 15h18M9 4v5M15 9v6M9 15v5"/>',bolt:'<path d="m13 2-3 8H4l7 12 3-8h6L13 2Z"/>',swap:'<path d="M4 7h15m-4-4 4 4-4 4M20 17H5m4-4-4 4 4 4"/>',chevron:'<path d="m6 9 6 6 6-6"/>'};
const icon=name=>'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'+icons[name]+'</svg>';
const money=n=>'$'+n.toLocaleString('es-DO',{minimumFractionDigits:2,maximumFractionDigits:2});
const number=n=>n.toLocaleString('es-DO',{maximumFractionDigits:2});
const signedMoney=n=>(n<0?'−':n>0?'+':'')+money(Math.abs(n));
const state={view:'profile',loan:false,help:false,payer:'Luis',payerChosen:false,primaryTeam:'Luis',team:'Marcos',daily:900,variant:'full',hours:8,extra:0,factor:1,enabled:true,expanded:false,second:false,invalid:false};
const shell=document.getElementById('shell'),body=document.getElementById('body'),title=document.getElementById('title'),hint=document.getElementById('hint'),next=document.getElementById('next'),back=document.getElementById('back');
document.getElementById('head-icon').innerHTML=icon('swap');document.getElementById('close').innerHTML=icon('close');
function person(){return '<div class="person"><span class="avatar">'+icon('people')+'</span><div><strong>Juan Pérez</strong><p>#113 · dos posiciones asignadas</p></div></div>';}
function teamName(){return state.team||'Sin líder';}
function payerName(){return state.loan?state.payer:teamName();}
function loanHelp(){
 const definitions='<div class="role-definitions"><p><strong>Líder del equipo</strong><br>Se sugiere desde la posición. Puedes cambiarlo solo para este empleado.</p><p><strong>Líder que paga</strong><br>Sin préstamo, paga el líder del equipo. Con préstamo, puedes elegir otro pagador, sugerido desde la posición principal.</p></div>';
 if(!state.team||state.loan&&!state.payer)return definitions+'<p class="muted">'+(!state.team?'Elige el líder del equipo para ver el recorrido.':'Elige el líder que paga para ver el recorrido.')+'</p>';
 const payer=payerName();
 const first='<div class="flow-lane" aria-label="El líder que paga es '+payer+', su nómina paga a Juan"><span class="flow-node"><small>PAGA</small><strong>'+payer+'</strong></span><span class="flow-arrow" aria-hidden="true">→</span><span class="flow-node"><small>NÓMINA DE</small><strong>'+payer+'</strong></span><span class="flow-arrow" aria-hidden="true">→</span><span class="flow-node"><small>RECIBE</small><strong>Juan</strong></span></div>';
 const second=!state.loan?'<p class="notice flow-same">Sin préstamo: el líder del equipo también paga. No hay descuento entre nóminas.</p>':state.team===payer?'<p class="notice flow-same">Mismo líder: sin descuento entre nóminas.</p>':'<div class="flow-lane flow-adjustment" aria-label="Al equipo de '+teamName()+' se le descuenta en su nómina el importe pagado por '+payer+'"><span class="flow-node"><small>EQUIPO</small><strong>'+teamName()+'</strong></span><span class="flow-arrow" aria-hidden="true">→</span><span class="flow-node"><small>SU NÓMINA</small><strong>Descuento</strong></span><span class="flow-arrow" aria-hidden="true">→</span><span class="flow-node"><small>AJUSTE</small><strong>−'+money(compute().wage)+'</strong></span></div>';
 return definitions+'<div class="payment-flow">'+first+second+'</div><p class="muted">Juan cobra una sola vez. Cambiar su líder no cambia a los demás empleados.</p>';
}
function profile(){return person()+`
 <div class="line"></div>
 <div class="card" id="primary-position">
  <div class="row"><span class="position-name">${icon('bricks')} Albañil</span><span class="chip warn">PRINCIPAL</span></div>
  <div class="position-fields"><div><span class="eyebrow">Tarifa por día</span><p class="num position-rate">$900</p></div>
   <label for="primary-team">Líder del equipo<select id="primary-team" aria-label="Líder del equipo de la posición principal" aria-describedby="primary-team-note"><option value="">Sin líder</option><option value="Luis">Luis</option><option>Marcos</option><option>Ana</option></select></label>
  </div><p class="muted" id="primary-team-note"></p>
 </div>
 <div class="card summary" id="assigned-position">
  <div class="row"><span class="position-name">${icon('bolt')} Electricista</span><span class="chip warn" id="loan-badge" aria-hidden="${!state.loan}">Préstamo</span></div>
  <div class="position-fields"><label for="rate">Tarifa por día<input id="rate" type="number" min="1" step="50" inputmode="decimal"></label>
   <label for="team">Líder del equipo<select id="team" aria-describedby="team-note"><option value="">Sin líder</option><option value="Marcos">Marcos</option><option>Ana</option><option>Luis</option></select></label>
  </div><p class="muted" id="team-note"></p>
  <div class="loan-switch-row"><label for="loan-switch">Posición de préstamo</label><button id="loan-help" type="button" class="help-button" aria-label="Qué significa cada líder y quién paga" aria-expanded="${state.help}" aria-controls="role-help-dialog" aria-haspopup="dialog"><span aria-hidden="true">?</span></button><input id="loan-switch" type="checkbox" role="switch" aria-checked="${state.loan}" aria-controls="loan-settings" ${state.loan?'checked':''}></div>
  <div id="loan-settings" class="profile-reveal" data-open="${state.loan}" aria-hidden="${!state.loan}"><div class="profile-reveal-inner"><div class="fields-leaders"><label for="payer">Líder que paga<select id="payer" aria-describedby="payer-note"><option value="">Selecciona pagador</option><option>Luis</option><option>Marcos</option><option>Ana</option></select></label></div><p class="muted" id="payer-note"></p></div></div>
 </div><p class="notice">Cada posición propone su líder. Los cambios se aplican solo a Juan.</p>`;}
function attendance(){return '<div class="segments" role="group" aria-label="Ejemplos de trabajo"><button data-case="full">Día completo</button><button data-case="half">Medio día</button><button data-case="holiday">Feriado ×2</button><button data-case="extra">2 h extra</button></div><div class="card"><div class="row"><h2>Electricista · '+teamName()+'</h2><span class="chip" id="day-label"></span></div><div class="grid"><div><span class="eyebrow">Horas base</span><strong class="hours num" id="base-hours"></strong></div><div><span class="eyebrow">Horas extra</span><strong class="hours num" id="extra-hours"></strong></div></div><p class="muted" id="expression"></p></div><div class="card summary"><span class="eyebrow">Juan · nómina de '+payerName()+'</span><strong class="big num" id="wage"></strong><p class="muted">El importe completo, una sola vez.</p></div><p class="notice" id="attendance-note"></p>';}
function report(){return '<div class="segments" role="group" aria-label="Comparar nóminas"><button data-leader="team" aria-pressed="true">Equipo · '+teamName()+'</button>'+(compute().cross?'<button data-leader="payer" aria-pressed="false">Pagador · '+payerName()+'</button>':'')+'</div><div id="report-content"></div>';}
function compute(){const wage=Math.round((state.hours/8*state.daily*state.factor+state.extra*state.daily/8*1.35)*100)/100,second=state.second?400:0,cross=state.loan&&!!state.payer&&!!state.team&&state.payer!==state.team,group=cross?wage+second:0,normal=500+(cross?0:wage+second),deduction=state.enabled?group:0;return {wage,second,cross,group,normal,deduction,balance:normal-deduction,payerPayroll:wage+second,globalEmployees:wage+second+500};}
function text(id,value){const el=document.getElementById(id);if(el)el.textContent=value;}
function expression(){const days=state.hours/8;return number(days)+(days===1?' día':' días')+' × '+money(state.daily)+(state.factor!==1?' × '+state.factor:'')+(state.extra?' + '+state.extra+' h extra × '+money(state.daily/8)+' × 1.35':'')+' = '+money(compute().wage);}
function updateProfile(){
 const settings=document.getElementById('loan-settings');
 if(!state.loan&&settings.contains(document.activeElement))document.getElementById('loan-switch').focus({preventScroll:true});
 settings.dataset.open=String(state.loan);settings.inert=!state.loan;settings.setAttribute('aria-hidden',String(!state.loan));
 const control=document.getElementById('loan-switch');control.checked=state.loan;control.setAttribute('aria-checked',String(state.loan));
 document.getElementById('loan-badge').setAttribute('aria-hidden',String(!state.loan));
 document.getElementById('loan-help').setAttribute('aria-expanded',String(roleDialog.open));
 document.getElementById('assigned-position').classList.toggle('is-loan',state.loan);
 text('primary-team-note',!state.primaryTeam?'Sin líder asignado.':state.primaryTeam==='Luis'?'Predeterminado de Albañil.':'Solo para Juan. Albañil conserva a Luis por defecto.');
 text('team-note',!state.team?'Sin líder asignado. El préstamo requiere un líder.':state.team==='Marcos'?'Predeterminado de Electricista.':'Solo para Juan. Electricista conserva a Marcos por defecto.');
 document.getElementById('payer').value=state.payer;
 text('payer-note',!state.payer?'Elige quién paga el importe completo.':state.payer===state.team?'El mismo líder: sin descuento entre nóminas.':!state.payerChosen?'Sugerido desde el líder de la posición principal.':'El pagador elegido cubre el importe completo.');
 const valid=!state.invalid&&(!state.loan||!!state.team&&!!state.payer);
 next.disabled=!valid;hint.textContent=state.invalid?'Completa una tarifa mayor que cero.':state.loan&&!state.team?'Elige el líder del equipo.':state.loan&&!state.payer?'Elige el líder que paga.':state.loan?'Sueldo completo en una sola nómina.':state.team?'Paga el líder del equipo.':'Sin líder: funcionamiento habitual.';
 for(const btn of document.querySelectorAll('[data-view]'))if(btn.dataset.view!=='profile')btn.disabled=!valid;
}
function updateAttendance(){const c=compute();text('base-hours',number(state.hours)+' h');text('extra-hours',number(state.extra)+' h');text('day-label',state.variant==='holiday'?'RECARGO DE EJEMPLO':'EJEMPLO');text('expression',expression());text('wage',money(c.wage));text('attendance-note',c.cross?'En la nómina de '+teamName()+' este trabajo solo entra en el grupo especial; no genera otro sueldo a Juan.':'El líder del equipo y el pagador coinciden; no se genera descuento de traslado.');for(const btn of document.querySelectorAll('[data-case]'))btn.setAttribute('aria-pressed',String(btn.dataset.case===state.variant));}
function detailRow(name,id,formula,amount){return '<div class="adjustment-person"><div class="row"><strong>'+name+' · #'+id+'</strong><strong class="num">'+money(amount)+'</strong></div><p class="muted">Paga '+state.payer+'</p><p class="num detail-expression">'+formula+'</p></div>';}
function updateReport(which='team') {
 const focusId=document.activeElement?.id,scroll=body.scrollTop,c=compute(),host=document.getElementById('report-content');
 if(!host)return;
 document.querySelectorAll('[data-leader]').forEach(btn=>btn.setAttribute('aria-pressed',String(btn.dataset.leader===which)));
 if(which==='payer'&&c.cross){
  host.innerHTML='<div class="card summary"><span class="eyebrow">Nómina de '+state.payer+'</span><strong class="big num">'+money(c.payerPayroll)+'</strong><p class="muted">Salarios reales a cargo de este pagador.</p></div><div class="card"><div class="row"><strong>Juan Pérez · #113</strong><strong class="num">'+money(c.wage)+'</strong></div><p class="muted">Electricista · trabajo para '+teamName()+'</p>'+(state.second?'<div class="line"></div><div class="row"><strong>Pedro Ruiz · #114</strong><strong class="num">$400.00</strong></div>':'')+'</div><p class="notice">Aquí se paga el salario completo. El ajuste del otro líder no se descuenta a Juan.</p>';
 } else {
  let group='';
  if(c.cross)group='<section class="card special-adjustment '+(!state.enabled?'muted-adjustment':'')+'" aria-label="Descuento de personal pagado por otros líderes"><div class="group-line"><input id="apply-adjustment" type="checkbox" aria-label="Aplicar descuento de personal pagado por otros líderes" '+(state.enabled?'checked':'')+'><button class="detail-toggle" id="detail-toggle" type="button" aria-expanded="'+state.expanded+'" aria-controls="adjustment-detail"><span>Personal pagado por otros líderes</span><small>'+(state.second?'2 empleados':'1 empleado')+' · '+(state.enabled?'Aplicado':'Desactivado')+' '+icon('chevron')+'</small></button><strong class="num" id="group-amount">'+(state.enabled?'−'+money(c.group):money(0))+'</strong></div><div id="adjustment-detail" '+(state.expanded?'':'hidden')+'>'+detailRow('Juan Pérez','113',expression(),c.wage)+(state.second?detailRow('Pedro Ruiz','114','0.5 día × $800.00 = $400.00',400):'')+'<p class="muted">Solo lectura: sin bonificaciones, descuentos personales ni cobros de préstamos.</p></div></section><label class="switch example-two">Datos de ejemplo: añadir Pedro<input id="second-employee" type="checkbox" '+(state.second?'checked':'')+'></label>';
  host.innerHTML='<div class="card"><span class="eyebrow">Nómina de empleados · '+teamName()+'</span><div class="row"><strong>Rosa Díaz · #024</strong><strong class="num">$500.00</strong></div>'+(!c.cross?'<div class="row"><strong>Juan Pérez · #113</strong><strong class="num">'+money(c.wage)+'</strong></div>'+(state.second?'<div class="row"><strong>Pedro Ruiz · #114</strong><strong class="num">$400.00</strong></div>':''):'')+'<div class="line"></div><div class="row"><span>Subtotal empleados</span><strong class="num" id="employee-subtotal">'+money(c.normal)+'</strong></div></div>'+group+(!c.cross?'<p class="notice">Sin descuento especial: el líder del equipo es quien paga.</p>':'')+'<div class="card summary leader-balance"><span class="eyebrow">Saldo del líder</span><strong class="big num" id="leader-balance">'+signedMoney(c.balance)+'</strong><p class="muted">'+(c.balance<0?'Saldo por compensar del líder. Los salarios de sus empleados se mantienen.':'El ajuste no cambia los salarios individuales.')+'</p></div>';
 }
 if(focusId)document.getElementById(focusId)?.focus({preventScroll:true});body.scrollTop=scroll;
}
function render(view){const before=shell.getBoundingClientRect();if(roleDialog.open)closeRoleHelp({animate:false,restore:false});state.view=view;title.textContent={profile:'Líder y quién paga',attendance:'Importe del trabajo',report:'Nómina y descuento'}[view];body.innerHTML=({profile,attendance,report}[view])();back.disabled=view==='profile';next.textContent=view==='report'?'Volver al empleado':view==='attendance'?'Ver nóminas':'Ver asistencia';hint.textContent=view==='report'?'El grupo no cambia salarios individuales.':view==='attendance'?'Recargos según posiciones normales.':'';next.disabled=false;for(const btn of document.querySelectorAll('[data-view]')){btn.disabled=false;btn.toggleAttribute('aria-current',btn.dataset.view===view);if(btn.hasAttribute('aria-current'))btn.setAttribute('aria-current','page');}if(view==='profile'){document.getElementById('rate').value=state.daily;document.getElementById('primary-team').value=state.primaryTeam;document.getElementById('team').value=state.team;document.getElementById('payer').value=state.payer;updateProfile();}else if(view==='attendance')updateAttendance();else updateReport();body.scrollTop=0;if(shell.open){const after=shell.getBoundingClientRect();if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&before.height&&before.height!==after.height)shell.animate([{height:before.height+'px'},{height:after.height+'px'}],{duration:260,easing:'cubic-bezier(.2,.8,.2,1)'});title.focus({preventScroll:true});}}
body.addEventListener('input',event=>{if(event.target.id==='rate'){state.invalid=event.target.value.trim()===''||!Number.isFinite(Number(event.target.value))||Number(event.target.value)<=0;if(!state.invalid)state.daily=Number(event.target.value);updateProfile();}});body.addEventListener('change',event=>{if(event.target.id==='loan-switch'){state.loan=event.target.checked;state.help=false;updateProfile();}if(event.target.id==='primary-team'){state.primaryTeam=event.target.value;if(!state.payerChosen)state.payer=state.primaryTeam;updateProfile();}if(event.target.id==='payer'||event.target.id==='team'){state[event.target.id]=event.target.value;if(event.target.id==='payer')state.payerChosen=true;updateProfile();}if(event.target.id==='apply-adjustment'){state.enabled=event.target.checked;updateReport();}if(event.target.id==='second-employee'){state.second=event.target.checked;updateReport();}});body.addEventListener('click',event=>{if(event.target.closest('#loan-help'))openRoleHelp();const preset=event.target.closest('[data-case]');if(preset){state.variant=preset.dataset.case;state.hours=state.variant==='half'?4:8;state.extra=state.variant==='extra'?2:0;state.factor=state.variant==='holiday'?2:1;updateAttendance();}if(event.target.closest('#detail-toggle')){state.expanded=!state.expanded;const control=document.getElementById('detail-toggle');control.setAttribute('aria-expanded',String(state.expanded));document.getElementById('adjustment-detail').hidden=!state.expanded;}const leader=event.target.closest('[data-leader]');if(leader)updateReport(leader.dataset.leader);});
const roleDialog=document.getElementById('role-help-dialog'),roleBody=document.getElementById('role-help-body');
let roleEpoch=0,roleMotion=null,roleClosing=false,roleReturnFocus=null,roleParentScroll=0;
function openRoleHelp(){
 if(roleDialog.open)return;
 roleEpoch++;roleClosing=false;roleMotion?.cancel();roleDialog.classList.remove('is-closing');
 roleReturnFocus=document.getElementById('loan-help');roleParentScroll=body.scrollTop;
 roleBody.innerHTML=loanHelp();roleBody.scrollTop=0;
 roleDialog.showModal();state.help=true;roleReturnFocus?.setAttribute('aria-expanded','true');
 document.getElementById('role-help-title').focus({preventScroll:true});
 if(!matchMedia('(prefers-reduced-motion: reduce)').matches){roleMotion=roleDialog.animate([{opacity:0,transform:'translateY(8px)'},{opacity:1,transform:'translateY(0)'}],{duration:180,easing:'cubic-bezier(.2,.8,.2,1)'});roleMotion.finished.catch(()=>{});}
}
async function closeRoleHelp({animate=true,restore=true}={}){
 if(!roleDialog.open||roleClosing&&animate)return;
 const token=++roleEpoch,style=getComputedStyle(roleDialog),from={opacity:style.opacity,transform:style.transform};
 roleClosing=true;roleMotion?.cancel();
 if(animate&&!matchMedia('(prefers-reduced-motion: reduce)').matches){
  roleDialog.classList.add('is-closing');
  roleMotion=roleDialog.animate([from,{opacity:0,transform:'translateY(6px)'}],{duration:140,easing:'cubic-bezier(.2,.8,.2,1)',fill:'forwards'});
  await roleMotion.finished.catch(()=>{});
 }
 if(token!==roleEpoch)return;
 roleDialog.close();roleMotion?.cancel();roleMotion=null;roleClosing=false;roleDialog.classList.remove('is-closing');
 state.help=false;document.getElementById('loan-help')?.setAttribute('aria-expanded','false');
 if(restore&&shell.open){body.scrollTop=roleParentScroll;(roleReturnFocus?.isConnected?roleReturnFocus:title).focus({preventScroll:true});}
}
document.getElementById('role-help-close').innerHTML=icon('close');
document.getElementById('role-help-close').onclick=()=>closeRoleHelp();
document.getElementById('role-help-done').onclick=()=>closeRoleHelp();
roleDialog.addEventListener('cancel',event=>{event.preventDefault();closeRoleHelp();});
roleDialog.addEventListener('keydown',event=>{
 if(event.key!=='Tab')return;
 const controls=[...roleDialog.querySelectorAll('button:not(:disabled),[tabindex="0"]')].filter(el=>el.getClientRects().length);
 const index=controls.indexOf(document.activeElement),last=controls.length-1;
 if(index<0||event.shiftKey&&index===0||!event.shiftKey&&index===last){event.preventDefault();controls[event.shiftKey?last:0]?.focus({preventScroll:true});}
});
roleDialog.addEventListener('click',event=>{if(event.target!==roleDialog)return;const r=roleDialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)closeRoleHelp();});
roleDialog.addEventListener('close',()=>{if(!roleDialog.open){state.help=false;document.getElementById('loan-help')?.setAttribute('aria-expanded','false');}});
next.onclick=()=>{if(state.view==='profile'&&!next.disabled)render('attendance');else if(state.view==='attendance')render('report');else if(state.view==='report')render('profile');};back.onclick=()=>render(state.view==='report'?'attendance':'profile');for(const btn of document.querySelectorAll('[data-view]'))btn.onclick=()=>{if(!btn.disabled)render(btn.dataset.view);};document.getElementById('close').onclick=()=>shell.close();document.getElementById('reopen').onclick=()=>{shell.showModal();title.focus();};shell.addEventListener('close',()=>{closeRoleHelp({animate:false,restore:false});document.getElementById('reopen').focus();});render('profile');shell.showModal();title.focus();

</script></body></html>
